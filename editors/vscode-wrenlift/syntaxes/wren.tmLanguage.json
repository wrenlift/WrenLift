{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wren",
  "scopeName": "source.wren",
  "fileTypes": ["wren"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#class-declaration" },
    { "include": "#imports" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#fields" },
    { "include": "#class-references" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.wren",
          "match": "(///|//!).*$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.documentation.wren" }
          }
        },
        {
          "name": "comment.line.double-slash.wren",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.wren" }
          }
        },
        {
          "name": "comment.block.wren",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.wren" }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.wren",
          "match": "(#!?)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.attribute.wren" },
            "2": { "name": "entity.other.attribute-name.wren" }
          }
        }
      ]
    },
    "class-declaration": {
      "begin": "\\b(foreign\\s+)?(class)\\s+([A-Z][A-Za-z0-9_]*)",
      "end": "(?=\\{|$)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.foreign.wren" },
        "2": { "name": "storage.type.class.wren" },
        "3": { "name": "entity.name.class.wren" }
      },
      "patterns": [
        {
          "match": "\\b(is)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.is.wren" },
            "2": { "name": "entity.other.inherited-class.wren" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.wren",
          "begin": "\\b(import)\\b",
          "end": "(?=$)",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.wren" }
          },
          "patterns": [
            { "include": "#strings" },
            {
              "match": "\\b(for|as)\\b",
              "name": "keyword.control.import.wren"
            },
            {
              "match": "\\b([A-Z][A-Za-z0-9_]*)\\b",
              "name": "entity.name.class.imported.wren"
            },
            {
              "match": "\\b([a-z_][A-Za-z0-9_]*)\\b",
              "name": "variable.other.imported.wren"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wren",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.wren" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.wren" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.wren",
              "match": "\\\\(['\"\\\\0abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
            },
            {
              "name": "meta.template.expression.wren",
              "begin": "%\\(",
              "end": "\\)",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.wren" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.wren" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.wren",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.float.wren",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.wren",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wren",
          "match": "\\b(if|else|while|for|in|return|break|continue)\\b"
        },
        {
          "name": "keyword.other.wren",
          "match": "\\b(import|as|is|class|foreign|static|construct|var)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.wren",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.wren",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.this.wren",
          "match": "\\bthis\\b"
        },
        {
          "name": "variable.language.super.wren",
          "match": "\\bsuper\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.wren",
          "match": "\\.\\.\\.|\\.\\."
        },
        {
          "name": "keyword.operator.comparison.wren",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.wren",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.wren",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.wren",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.wren",
          "match": "&|\\||\\^|~|<<|>>"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "name": "variable.other.static-field.wren",
          "match": "\\b__[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.field.wren",
          "match": "\\b_[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "class-references": {
      "patterns": [
        {
          "name": "support.class.builtin.wren",
          "match": "\\b(Bool|Class|Fiber|Fn|List|Map|Null|Num|Object|Range|Sequence|String|System)\\b"
        },
        {
          "name": "entity.name.class.wren",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.wren" }
          }
        },
        {
          "name": "variable.other.wren",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
